# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Add the same two values to Vercel → Settings → Environment Variables.
# Both are safe in the browser: Row Level Security protects the data. Never add a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI coach, meal logging from text/photos, diet plans. Server-only: never add NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com (API keys). Leave empty to switch the AI features off.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.6-flash.
GEMINI_MODEL=
